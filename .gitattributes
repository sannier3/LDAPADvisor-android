# Auto-detect text files and normalize line endings
* text=auto

# Source and config — force LF
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.gradle text eol=lf
*.pro text eol=lf
*.keep text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows scripts — CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jks binary
*.keystore binary
*.apk binary
*.aab binary
*.aar binary
*.dex binary
*.so binary
*.jar binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
