# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle
.gradle/
build/
**/build/

# Local SDK / machine config — never publish
local.properties

# IDE — keep the public repo free of editor/machine noise
.idea/
*.iml
.fleet/
.vscode/
!.vscode/extensions.json

# Cursor local state (not part of the published app)
.cursor/

# NDK
.externalNativeBuild/
.cxx/
obj/

# Android Studio captures / profiling
captures/
*.hprof
hs_err_pid*
replay_pid*

# Signing / secrets — never commit these
*.jks
*.keystore
keystore.properties
signing.properties
secrets.properties
.env
.env.*
*.pem
*.p12
*.key

# Credentials / sensitive paths
**/credentials*.json
**/secrets/
*.secret

# Log / local build artefacts
*.log
/build-*.log
/build-*.txt

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor junk
*.swp
*~

# Kotlin
.kotlin/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Lint leftovers outside build/
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Package archives (keep the Gradle wrapper JAR)
*.jar
!gradle/wrapper/gradle-wrapper.jar
!**/libs/*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Temporary / patch leftovers
*.tmp
*.temp
*.bak
*.orig
*.rej
