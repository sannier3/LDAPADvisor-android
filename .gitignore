# Do not ignore the entire .idea/ directory.

# NDK
.externalNativeBuild/
.cxx/
obj/

# Android Studio captures / profiling
captures/
*.hprof

# Google Services (uncomment if generated locally and not meant to be shared)
# google-services.json

